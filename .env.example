# ============================================================
# Environment Variables — HOW TO SET UP
# ============================================================
# 1. Copy this file and rename it to ".env" (remove ".example")
# 2. Fill in each value below with your real credentials
# 3. Restart the dev server — the app will switch from
#    Demo Mode to Live Mode automatically.
# ============================================================

# --- Supabase ---------------------------------------------------
# 1. Create a free project at https://supabase.com
# 2. Go to your project → Settings → API
# 3. Copy the "Project URL" and "anon public" key below
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Cloudinary (image uploads) --------------------------------
# 1. Create a free account at https://cloudinary.com
# 2. Go to Settings → Upload → Upload presets
# 3. Create a new preset, set it to "Unsigned", copy its name
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_name
